<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orozco Piel - Calzado Artesanal</title>
    
    <!-- Carga de Tailwind CSS para estilos rápidos y responsivos -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Carga de íconos de FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Carga de tipografías elegantes (Playfair Display para títulos, Inter para textos) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <!-- Configuración personalizada de los colores (Tonos Piel, Café, Beige, Negro y Blanco) -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        piel: {
                            oscuro: '#2C1A14', /* Café casi negro para contrastes */
                            medio: '#5C3A21',  /* Café cuero clásico */
                            claro: '#A67B5B',  /* Tono camel/miel */
                            beige: '#F4F0EB',  /* Fondo crema/beige muy suave */
                        },
                        negro: '#121212',
                        blanco: '#FFFFFF'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Estilos base adicionales y animaciones suaves */
        body {
            background-color: #F4F0EB;
            color: #2C1A14;
        }
        
        .hero-bg {
            /* Imagen de fondo representativa de zapatos de piel elegantes */
            background-image: url('https://images.unsplash.com/photo-1614252339460-e17635c677ea?q=80&w=2000&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }
        
        .hero-overlay {
            /* Capa semitransparente para que el texto sea legible */
            background: linear-gradient(to right, rgba(20, 10, 5, 0.8), rgba(44, 26, 20, 0.4));
        }

        /* Efecto elegante de subrayado en los enlaces de navegación */
        .nav-link {
            position: relative;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: -4px;
            left: 0;
            background-color: #5C3A21;
            transition: width 0.3s ease;
        }
        .nav-link:hover::after {
            width: 100%;
        }

        /* Transiciones suaves para botones */
        .btn-primary {
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(92, 58, 33, 0.3);
        }
    </style>
</head>
<body class="font-sans antialiased flex flex-col min-h-screen">

    <header class="fixed w-full top-0 z-50 bg-piel-beige/95 backdrop-blur-sm border-b border-piel-claro/20 transition-all">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            
            <!-- Menú Hamburguesa para Móviles (Solo visual en este paso) -->
            <button class="md:hidden text-piel-oscuro focus:outline-none">
                <i class="fas fa-bars text-xl"></i>
            </button>

            <!-- Logotipo de la marca -->
            <a href="#" class="font-serif text-2xl font-bold tracking-wider text-piel-oscuro flex-1 text-center md:text-left md:flex-none">
                OROZCO PIEL
            </a>

            <!-- Enlaces de navegación (Ocultos en móviles, visibles en pantallas medianas o grandes) -->
            <nav class="hidden md:flex space-x-8 text-sm font-medium tracking-wide">
                <a href="#" class="nav-link text-piel-oscuro hover:text-piel-medio">Inicio</a>
                <a href="#catalogo" class="nav-link text-piel-oscuro hover:text-piel-medio">Catálogo</a>
                <a href="#nosotros" class="nav-link text-piel-oscuro hover:text-piel-medio">Nosotros</a>
                <a href="#contacto" class="nav-link text-piel-oscuro hover:text-piel-medio">Contacto</a>
            </nav>

            <!-- Ícono del carrito de compras -->
            <div class="flex items-center">
                <button class="relative text-piel-oscuro hover:text-piel-medio transition">
                    <i class="fas fa-shopping-bag text-xl"></i>
                    <!-- Notificador de artículos en el carrito -->
                    <span class="absolute -top-1 -right-2 bg-piel-medio text-blanco text-[10px] font-bold px-1.5 py-0.5 rounded-full">
                        0
                    </span>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow">
        <!-- Hero Section -->
        <section class="relative h-screen flex items-center hero-bg">
            <div class="absolute inset-0 hero-overlay"></div>
            
            <div class="container mx-auto px-6 relative z-10 text-left">
                <div class="max-w-xl">
                    <p class="text-piel-claro text-sm md:text-base font-semibold tracking-widest uppercase mb-3">
                        Tradición y Elegancia
                    </p>
                    <h1 class="font-serif text-5xl md:text-6xl text-blanco font-bold leading-tight mb-6">
                        El arte de caminar <br/> con estilo.
                    </h1>
                    <p class="text-piel-beige text-lg md:text-xl font-light mb-10 max-w-md">
                        Calzado de piel hecho a mano por maestros artesanos. Descubre la colección exclusiva de la familia Orozco.
                    </p>
                    <a href="#catalogo" class="btn-primary bg-blanco text-piel-oscuro font-medium py-3 px-8 rounded uppercase tracking-wider text-sm hover:bg-piel-beige inline-block">
                        Ver Colección
                    </a>
                </div>
            </div>
        </section>

        <!-- Breve introducción (Opcional, pero da buen balance minimalista) -->
        <section id="nosotros" class="py-20 bg-piel-beige">
            <div class="container mx-auto px-6 text-center max-w-3xl">
                <h2 class="font-serif text-3xl md:text-4xl text-piel-oscuro mb-6">Artesanía en cada paso</h2>
                <div class="w-16 h-0.5 bg-piel-medio mx-auto mb-6"></div>
                <p class="text-piel-oscuro/80 text-lg font-light leading-relaxed">
                    En Orozco Piel, seleccionamos los mejores cortes para crear calzado que no solo luce impecable, sino que perdura con el tiempo. Cada costura es un homenaje a la marroquinería clásica.
                </p>
            </div>
        </section>
    </main>

    <footer class="bg-piel-oscuro text-piel-beige pt-16 pb-8 border-t-4 border-piel-medio">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 mb-12 text-center md:text-left">
                
                <!-- Columna de Marca -->
                <div>
                    <h3 class="font-serif text-2xl font-bold tracking-wider mb-4 text-blanco">OROZCO PIEL</h3>
                    <p class="text-sm font-light text-piel-beige/70 leading-relaxed max-w-xs mx-auto md:mx-0">
                        Auténtico calzado de piel, diseñado para quienes valoran la elegancia y la calidad artesanal.
                    </p>
                </div>

                <!-- Columna de Enlaces Legales/Soporte -->
                <div>
                    <h4 class="font-sans font-semibold tracking-widest text-sm uppercase mb-4 text-piel-claro">Atención al Cliente</h4>
                    <ul class="space-y-2 text-sm font-light text-piel-beige/80">
                        <li><a href="#" class="hover:text-blanco transition">Políticas de Privacidad</a></li>
                        <li><a href="#" class="hover:text-blanco transition">Términos y Condiciones</a></li>
                        <li><a href="#" class="hover:text-blanco transition">Envíos y Devoluciones</a></li>
                        <li><a href="#" class="hover:text-blanco transition">Guía de Tallas</a></li>
                    </ul>
                </div>

                <!-- Columna de Redes Sociales -->
                <div>
                    <h4 class="font-sans font-semibold tracking-widest text-sm uppercase mb-4 text-piel-claro">Síguenos</h4>
                    <div class="flex justify-center md:justify-start space-x-5">
                        <a href="#" class="w-10 h-10 rounded-full border border-piel-beige/30 flex items-center justify-center hover:bg-piel-medio hover:border-piel-medio transition text-blanco">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-full border border-piel-beige/30 flex items-center justify-center hover:bg-piel-medio hover:border-piel-medio transition text-blanco">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-full border border-piel-beige/30 flex items-center justify-center hover:bg-piel-medio hover:border-piel-medio transition text-blanco">
                            <i class="fab fa-pinterest-p"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Copyright -->
            <div class="border-t border-piel-beige/10 pt-8 text-center text-xs text-piel-beige/50 font-light">
                <p>&copy; 2023 Orozco Piel. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

</body>
</html>6
