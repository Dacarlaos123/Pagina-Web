<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orozco Piel - Calzado Artesanal</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- Iconos (Feather Icons) -->
    <script src="https://unpkg.com/feather-icons"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        piel: {
                            oscuro: '#4A3728', // Café tostado
                            medio: '#8B5A2B',  // Café cuero
                            claro: '#C19A6B',  // Camel
                            beige: '#F9F6F0'   // Fondo crema
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Transiciones suaves */
        .fade-in { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* Ocultar barra de scroll en modales */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-piel-beige text-gray-800 font-sans flex flex-col min-h-screen">

    <!-- Navegación -->
    <nav class="bg-white shadow-sm sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center cursor-pointer" onclick="cambiarVista('inicio')">
                    <h1 class="font-serif text-3xl font-bold text-piel-oscuro">Orozco Piel</h1>
                </div>
                <!-- Menú Desktop -->
                <div class="hidden md:flex space-x-8 items-center">
                    <a href="#" onclick="cambiarVista('inicio')" class="text-gray-600 hover:text-piel-medio transition">Inicio</a>
                    <a href="#" onclick="cambiarVista('catalogo')" class="text-gray-600 hover:text-piel-medio transition">Catálogo</a>
                    <a href="#" onclick="cambiarVista('admin')" class="text-piel-medio font-semibold hover:text-piel-oscuro transition flex items-center gap-1">
                        <i data-feather="settings" class="w-4 h-4"></i> Admin
                    </a>
                    <!-- Icono Carrito -->
                    <button onclick="toggleCarrito()" class="relative text-piel-oscuro hover:text-piel-medio transition">
                        <i data-feather="shopping-bag"></i>
                        <span id="contador-carrito" class="absolute -top-2 -right-2 bg-piel-medio text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">0</span>
                    </button>
                </div>
                <!-- Menú Móvil -->
                <div class="md:hidden flex items-center gap-4">
                    <button onclick="toggleCarrito()" class="relative text-piel-oscuro">
                        <i data-feather="shopping-bag"></i>
                        <span id="contador-carrito-movil" class="absolute -top-2 -right-2 bg-piel-medio text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">0</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Contenedor Principal (Vistas Dinámicas) -->
    <main class="flex-grow">
        
        <!-- VISTA 1: INICIO -->
        <div id="vista-inicio" class="fade-in block">
            <div class="relative bg-piel-oscuro h-[60vh] flex items-center justify-center overflow-hidden">
                <img src="https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&q=80&w=2000" alt="Taller de Piel" class="absolute inset-0 w-full h-full object-cover opacity-40">
                <div class="relative z-10 text-center px-4">
                    <h2 class="text-4xl md:text-6xl font-serif text-white mb-4">Herencia en cada paso</h2>
                    <p class="text-lg md:text-xl text-piel-beige mb-8 font-light max-w-2xl mx-auto">Calzado artesanal confeccionado con la más fina selección de pieles. La tradición de la familia Orozco directo a tus pies.</p>
                    <button onclick="cambiarVista('catalogo')" class="bg-piel-claro hover:bg-piel-medio text-white px-8 py-3 rounded-sm font-semibold tracking-wide transition duration-300">
                        Ver Colección
                    </button>
                </div>
            </div>
        </div>

        <!-- VISTA 2: CATÁLOGO -->
        <div id="vista-catalogo" class="fade-in hidden max-w-7xl mx-auto px-4 py-12">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-serif text-piel-oscuro mb-2">Nuestra Colección</h2>
                <div class="h-1 w-20 bg-piel-medio mx-auto"></div>
            </div>
            <!-- Cuadrícula de Productos -->
            <div id="contenedor-productos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Se llena con JS -->
            </div>
        </div>

        <!-- VISTA 3: CHECKOUT (PAGO) -->
        <div id="vista-checkout" class="fade-in hidden max-w-6xl mx-auto px-4 py-12">
            <h2 class="text-3xl font-serif text-piel-oscuro mb-8 text-center">Finalizar Compra</h2>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                <!-- Formulario -->
                <div class="lg:col-span-2 space-y-8">
                    <!-- Envío -->
                    <div class="bg-white p-6 shadow-sm rounded-md border border-gray-100">
                        <h3 class="text-xl font-serif text-piel-oscuro mb-4 flex items-center gap-2">
                            <i data-feather="map-pin"></i> 1. Datos de Envío
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <input type="text" id="chk-nombre" placeholder="Nombre completo" class="border border-gray-300 p-3 rounded-md w-full focus:outline-none focus:border-piel-medio">
                            <input type="email" id="chk-correo" placeholder="Correo electrónico" class="border border-gray-300 p-3 rounded-md w-full focus:outline-none focus:border-piel-medio">
                            <input type="text" id="chk-direccion" placeholder="Dirección completa (Calle y número)" class="border border-gray-300 p-3 rounded-md w-full md:col-span-2 focus:outline-none focus:border-piel-medio">
                        </div>
                    </div>
                    <!-- Pago -->
                    <div class="bg-white p-6 shadow-sm rounded-md border border-gray-100">
                        <h3 class="text-xl font-serif text-piel-oscuro mb-4 flex items-center gap-2">
                            <i data-feather="credit-card"></i> 2. Método de Pago
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Opción Tarjeta -->
                            <div id="btn-pago-tarjeta" onclick="seleccionarPago('tarjeta')" class="border-2 border-gray-200 p-4 rounded-md cursor-pointer hover:border-piel-medio transition text-center">
                                <i data-feather="credit-card" class="mx-auto mb-2 text-piel-oscuro"></i>
                                <span class="font-semibold text-piel-oscuro">Tarjeta de Crédito/Débito</span>
                            </div>
                            <!-- Opción OXXO -->
                            <div id="btn-pago-oxxo" onclick="seleccionarPago('oxxo')" class="border-2 border-gray-200 p-4 rounded-md cursor-pointer hover:border-piel-medio transition text-center">
                                <i data-feather="dollar-sign" class="mx-auto mb-2 text-piel-oscuro"></i>
                                <span class="font-semibold text-piel-oscuro">Pago en OXXO / Efectivo</span>
                            </div>
                        </div>

                        <!-- Formulario de Tarjeta (Oculto por defecto) -->
                        <div id="formulario-tarjeta" class="hidden mt-6 bg-gray-50 p-4 rounded-md border border-gray-200">
                            <div class="space-y-4">
                                <input type="text" id="tarjeta-numero" placeholder="Número de Tarjeta (16 dígitos)" maxlength="16" class="border border-gray-300 p-3 rounded-md w-full focus:outline-none focus:border-piel-medio">
                                <input type="text" id="tarjeta-nombre" placeholder="Nombre en la Tarjeta" class="border border-gray-300 p-3 rounded-md w-full focus:outline-none focus:border-piel-medio">
                                <div class="grid grid-cols-2 gap-4">
                                    <input type="text" id="tarjeta-fecha" placeholder="MM/AA" maxlength="5" class="border border-gray-300 p-3 rounded-md w-full focus:outline-none focus:border-piel-medio">
                                    <input type="text" id="tarjeta-cvv" placeholder="CVV" maxlength="3" class="border border-gray-300 p-3 rounded-md w-full focus:outline-none focus:border-piel-medio">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Resumen Fijo -->
                <div class="lg:col-span-1">
                    <div class="bg-white p-6 shadow-sm rounded-md border border-gray-100 sticky top-24">
                        <h3 class="text-xl font-serif text-piel-oscuro mb-4">Resumen del Pedido</h3>
                        <div id="checkout-lista" class="space-y-3 mb-6 max-h-60 overflow-y-auto no-scrollbar">
                            <!-- Se llena con JS -->
                        </div>
                        <div class="border-t border-gray-200 pt-4 flex justify-between items-center mb-6">
                            <span class="font-semibold text-gray-600">Total a Pagar:</span>
                            <span id="checkout-total" class="text-2xl font-bold text-piel-oscuro">$0.00 MXN</span>
                        </div>
                        <button onclick="procesarCompra()" class="w-full bg-piel-oscuro hover:bg-piel-medio text-white py-3 rounded-md font-semibold transition">
                            Confirmar Pedido
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- VISTA 4: ADMIN -->
        <div id="vista-admin" class="fade-in hidden max-w-7xl mx-auto px-4 py-12">
            <div class="flex justify-between items-center mb-8">
                <h2 class="text-3xl font-serif text-piel-oscuro">Panel de Administración</h2>
            </div>
            <div class="bg-white shadow-sm rounded-md border border-gray-200 overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-piel-oscuro font-semibold">
                            <th class="p-4 border-b">ID</th>
                            <th class="p-4 border-b">Imagen</th>
                            <th class="p-4 border-b">Nombre del Producto</th>
                            <th class="p-4 border-b">Precio</th>
                            <th class="p-4 border-b">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-admin">
                        <!-- Se llena con JS -->
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-piel-oscuro text-piel-beige py-10 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h2 class="font-serif text-2xl mb-4">Orozco Piel</h2>
            <p class="font-light text-sm opacity-80 mb-6">Tradición familiar en cada puntada. Hecho a mano en México.</p>
            <div class="flex justify-center space-x-6 text-sm">
                <a href="#" class="hover:text-white">Instagram</a>
                <a href="#" class="hover:text-white">Facebook</a>
                <a href="#" class="hover:text-white">Políticas de Envío</a>
            </div>
        </div>
    </footer>

    <!-- MODAL DEL CARRITO LATERAL -->
    <div id="modal-carrito" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden justify-end transition-opacity">
        <div class="bg-white w-full max-w-md h-full shadow-2xl flex flex-col fade-in">
            <div class="p-6 bg-piel-beige flex justify-between items-center border-b border-piel-claro">
                <h3 class="text-xl font-serif text-piel-oscuro">Tu Carrito</h3>
                <button onclick="toggleCarrito()" class="text-gray-500 hover:text-piel-oscuro"><i data-feather="x"></i></button>
            </div>
            <div id="carrito-lista" class="flex-grow p-6 overflow-y-auto space-y-4">
                <p class="text-center text-gray-500 mt-10">Tu carrito está vacío.</p>
            </div>
            <div class="p-6 border-t border-gray-200 bg-gray-50">
                <div class="flex justify-between items-center mb-4">
                    <span class="font-bold text-gray-700">Total:</span>
                    <span id="carrito-total" class="font-bold text-xl text-piel-oscuro">$0.00 MXN</span>
                </div>
                <button onclick="irACheckout()" class="w-full bg-piel-medio hover:bg-piel-oscuro text-white py-3 rounded-md font-semibold transition">
                    Ir a Pagar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE MENSAJES (Alertas de éxito/error) -->
    <div id="modal-mensaje" class="fixed inset-0 bg-black bg-opacity-50 z-[60] hidden items-center justify-center">
        <div class="bg-white p-8 rounded-md shadow-xl text-center max-w-sm w-full fade-in">
            <div id="modal-icono" class="mx-auto mb-4 text-piel-medio flex justify-center"></div>
            <h3 id="modal-titulo" class="text-2xl font-serif text-piel-oscuro mb-2">Mensaje</h3>
            <p id="modal-texto" class="text-gray-600 mb-6">Texto del mensaje.</p>
            <button onclick="cerrarModalMensaje()" class="bg-piel-oscuro text-white px-6 py-2 rounded-md hover:bg-piel-medio transition">Aceptar</button>
        </div>
    </div>

    <!-- MODAL EDICIÓN ADMIN -->
    <div id="modal-admin-editar" class="fixed inset-0 bg-black bg-opacity-50 z-[60] hidden items-center justify-center">
        <div class="bg-white p-8 rounded-md shadow-xl max-w-md w-full fade-in">
            <h3 class="text-2xl font-serif text-piel-oscuro mb-4">Editar Producto</h3>
            <input type="hidden" id="edit-id">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Nombre</label>
                    <input type="text" id="edit-nombre" class="w-full border border-gray-300 p-2 rounded focus:border-piel-medio outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Precio (MXN)</label>
                    <input type="number" id="edit-precio" class="w-full border border-gray-300 p-2 rounded focus:border-piel-medio outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">URL de la Imagen</label>
                    <input type="text" id="edit-imagen" class="w-full border border-gray-300 p-2 rounded focus:border-piel-medio outline-none text-sm">
                </div>
            </div>
            <div class="mt-6 flex justify-end space-x-3">
                <button onclick="cerrarModalAdmin()" class="px-4 py-2 text-gray-600 hover:text-gray-800">Cancelar</button>
                <button onclick="guardarEdicionProducto()" class="bg-piel-medio text-white px-4 py-2 rounded hover:bg-piel-oscuro">Guardar Cambios</button>
            </div>
        </div>
    </div>

    <!-- LÓGICA DE LA TIENDA (JavaScript) -->
    <script>
        // Iniciar íconos
        feather.replace();

        // 1. BASE DE DATOS DEL INVENTARIO (Mutable para el Admin)
        // Se actualizaron los enlaces de Unsplash para evitar imágenes rotas
        let inventario = [
            { id: 1, nombre: "Botas de Piel Clásicas", categoria: "Hombre", precio: 1850, img: "https://images.unsplash.com/photo-1605812860427-4024433a70fd?auto=format&fit=crop&q=80&w=600" },
            { id: 2, nombre: "Zapatos Oxford", categoria: "Hombre", precio: 1400, img: "https://images.unsplash.com/photo-1614252209318-4228af26388f?auto=format&fit=crop&q=80&w=600" },
            { id: 3, nombre: "Mocasines de Antelina", categoria: "Unisex", precio: 1200, img: "https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?auto=format&fit=crop&q=80&w=600" },
            { id: 4, nombre: "Botines Casuales", categoria: "Mujer", precio: 1650, img: "https://images.unsplash.com/photo-1638247025967-b4e38f787b76?auto=format&fit=crop&q=80&w=600" },
            { id: 5, nombre: "Sandalias Artesanales", categoria: "Mujer", precio: 850, img: "https://images.unsplash.com/photo-1603487742131-4160ec999306?auto=format&fit=crop&q=80&w=600" },
            { id: 6, nombre: "Botas de Montar", categoria: "Mujer", precio: 2200, img: "https://images.unsplash.com/photo-1520639888713-7851133b1ed0?auto=format&fit=crop&q=80&w=600" },
            { id: 7, nombre: "Mocasines Clásicos Piel", categoria: "Hombre", precio: 1350, img: "https://images.unsplash.com/photo-1533867617858-e7b97e060509?auto=format&fit=crop&q=80&w=600" },
            { id: 8, nombre: "Zapatos de Vestir Negros", categoria: "Hombre", precio: 1900, img: "https://images.unsplash.com/photo-1614252339460-e1f4220c3cb4?auto=format&fit=crop&q=80&w=600" }
        ];

        let carrito = [];
        let metodoPagoSeleccionado = null;

        // 2. NAVEGACIÓN Y VISTAS
        function cambiarVista(vista) {
            document.getElementById('vista-inicio').classList.add('hidden');
            document.getElementById('vista-catalogo').classList.add('hidden');
            document.getElementById('vista-checkout').classList.add('hidden');
            document.getElementById('vista-admin').classList.add('hidden');
            
            document.getElementById('vista-' + vista).classList.remove('hidden');
            
            if(vista === 'catalogo') renderizarCatalogo();
            if(vista === 'admin') renderizarAdmin();
            window.scrollTo(0,0);
        }

        // 3. RENDERIZAR EL CATÁLOGO (Lee de la base de datos)
        function renderizarCatalogo() {
            const contenedor = document.getElementById('contenedor-productos');
            contenedor.innerHTML = ''; 

            inventario.forEach(producto => {
                const tarjeta = `
                    <div class="bg-white rounded-md overflow-hidden shadow-sm hover:shadow-xl transition duration-300 transform hover:-translate-y-1 group">
                        <div class="relative h-64 overflow-hidden">
                            <img src="${producto.img}" alt="${producto.nombre}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            <span class="absolute top-2 left-2 bg-white px-2 py-1 text-xs font-bold text-piel-oscuro rounded shadow opacity-90">${producto.categoria}</span>
                        </div>
                        <div class="p-5 text-center">
                            <h3 class="font-serif text-lg text-piel-oscuro mb-1">${producto.nombre}</h3>
                            <p class="text-gray-500 font-semibold mb-4">$${producto.precio.toLocaleString('es-MX')} MXN</p>
                            <button onclick="agregarAlCarrito(${producto.id})" class="w-full bg-transparent border border-piel-medio text-piel-medio hover:bg-piel-medio hover:text-white py-2 rounded transition flex items-center justify-center gap-2">
                                <i data-feather="shopping-cart" class="w-4 h-4"></i> Agregar
                            </button>
                        </div>
                    </div>
                `;
                contenedor.innerHTML += tarjeta;
            });
            feather.replace(); // Recargar iconos
        }

        // 4. LÓGICA DEL CARRITO
        function toggleCarrito() {
            const modal = document.getElementById('modal-carrito');
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                actualizarVisualCarrito();
            } else {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        function agregarAlCarrito(id) {
            const producto = inventario.find(p => p.id === id);
            carrito.push(producto);
            actualizarContadores();
            mostrarMensaje('¡Agregado!', `${producto.nombre} se añadió a tu carrito.`, 'check-circle');
        }

        function eliminarDelCarrito(index) {
            carrito.splice(index, 1);
            actualizarContadores();
            actualizarVisualCarrito();
            actualizarVisualCheckout();
        }

        function actualizarContadores() {
            document.getElementById('contador-carrito').innerText = carrito.length;
            document.getElementById('contador-carrito-movil').innerText = carrito.length;
        }

        function calcularTotal() {
            return carrito.reduce((total, producto) => total + producto.precio, 0);
        }

        function actualizarVisualCarrito() {
            const contenedor = document.getElementById('carrito-lista');
            const spanTotal = document.getElementById('carrito-total');
            
            if (carrito.length === 0) {
                contenedor.innerHTML = '<p class="text-center text-gray-500 mt-10">Tu carrito está vacío.</p>';
                spanTotal.innerText = '$0.00 MXN';
                return;
            }

            contenedor.innerHTML = '';
            carrito.forEach((prod, index) => {
                contenedor.innerHTML += `
                    <div class="flex items-center gap-4 border-b border-gray-100 pb-4">
                        <img src="${prod.img}" class="w-16 h-16 object-cover rounded">
                        <div class="flex-grow">
                            <h4 class="text-sm font-semibold text-piel-oscuro">${prod.nombre}</h4>
                            <p class="text-sm text-gray-500">$${prod.precio.toLocaleString('es-MX')} MXN</p>
                        </div>
                        <button onclick="eliminarDelCarrito(${index})" class="text-red-400 hover:text-red-600"><i data-feather="trash-2" class="w-4 h-4"></i></button>
                    </div>
                `;
            });
            spanTotal.innerText = `$${calcularTotal().toLocaleString('es-MX')} MXN`;
            feather.replace();
        }

        // 5. LÓGICA DE CHECKOUT Y PAGO
        function irACheckout() {
            if(carrito.length === 0) {
                mostrarMensaje('Carrito Vacío', 'Agrega productos antes de pagar.', 'alert-circle');
                return;
            }
            toggleCarrito(); // Cierra el carrito
            cambiarVista('checkout');
            actualizarVisualCheckout();
        }

        function actualizarVisualCheckout() {
            const contenedor = document.getElementById('checkout-lista');
            const spanTotal = document.getElementById('checkout-total');
            
            contenedor.innerHTML = '';
            carrito.forEach(prod => {
                contenedor.innerHTML += `
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">${prod.nombre}</span>
                        <span class="font-semibold text-piel-oscuro">$${prod.precio.toLocaleString('es-MX')}</span>
                    </div>
                `;
            });
            spanTotal.innerText = `$${calcularTotal().toLocaleString('es-MX')} MXN`;
        }

        // Selección de Método de Pago y Mostrar Formulario de Tarjeta
        function seleccionarPago(metodo) {
            metodoPagoSeleccionado = metodo;
            const btnTarjeta = document.getElementById('btn-pago-tarjeta');
            const btnOxxo = document.getElementById('btn-pago-oxxo');
            const formTarjeta = document.getElementById('formulario-tarjeta');

            // Resetear estilos
            btnTarjeta.classList.remove('border-piel-medio', 'bg-piel-beige');
            btnOxxo.classList.remove('border-piel-medio', 'bg-piel-beige');

            if (metodo === 'tarjeta') {
                btnTarjeta.classList.add('border-piel-medio', 'bg-piel-beige');
                formTarjeta.classList.remove('hidden'); // Mostrar inputs de tarjeta
            } else {
                btnOxxo.classList.add('border-piel-medio', 'bg-piel-beige');
                formTarjeta.classList.add('hidden'); // Ocultar inputs de tarjeta
            }
        }

        function procesarCompra() {
            const nombre = document.getElementById('chk-nombre').value;
            const correo = document.getElementById('chk-correo').value;
            const direccion = document.getElementById('chk-direccion').value;

            if(!nombre || !correo || !direccion || !metodoPagoSeleccionado) {
                mostrarMensaje('Faltan Datos', 'Por favor, llena tu información de envío y selecciona un método de pago.', 'alert-circle');
                return;
            }

            // Validar tarjeta si fue seleccionada
            if(metodoPagoSeleccionado === 'tarjeta') {
                const num = document.getElementById('tarjeta-numero').value;
                const nom = document.getElementById('tarjeta-nombre').value;
                const fecha = document.getElementById('tarjeta-fecha').value;
                const cvv = document.getElementById('tarjeta-cvv').value;

                if(!num || !nom || !fecha || !cvv) {
                    mostrarMensaje('Datos de Tarjeta', 'Por favor completa los datos de tu tarjeta para procesar el pago.', 'credit-card');
                    return;
                }
            }

            mostrarMensaje('¡Pedido Confirmado!', `Gracias por tu compra, ${nombre}. Hemos enviado los detalles a ${correo}.`, 'check-circle');
            
            // Limpiar carrito y formulario tras comprar
            carrito = [];
            actualizarContadores();
            document.getElementById('chk-nombre').value = '';
            document.getElementById('chk-correo').value = '';
            document.getElementById('chk-direccion').value = '';
            document.getElementById('tarjeta-numero').value = '';
            document.getElementById('tarjeta-nombre').value = '';
            document.getElementById('tarjeta-fecha').value = '';
            document.getElementById('tarjeta-cvv').value = '';
            setTimeout(() => cambiarVista('inicio'), 3000);
        }

        // 6. LÓGICA DEL PANEL DE ADMINISTRACIÓN (NUEVO)
        function renderizarAdmin() {
            const tabla = document.getElementById('tabla-admin');
            tabla.innerHTML = '';

            inventario.forEach(prod => {
                tabla.innerHTML += `
                    <tr class="border-b border-gray-100 hover:bg-gray-50">
                        <td class="p-4 text-gray-500">#${prod.id}</td>
                        <td class="p-4"><img src="${prod.img}" class="w-12 h-12 object-cover rounded"></td>
                        <td class="p-4 font-semibold text-gray-700">${prod.nombre}</td>
                        <td class="p-4 text-piel-oscuro font-bold">$${prod.precio}</td>
                        <td class="p-4">
                            <button onclick="abrirModalAdmin(${prod.id})" class="text-blue-600 hover:text-blue-800 text-sm font-semibold flex items-center gap-1">
                                <i data-feather="edit-2" class="w-4 h-4"></i> Editar
                            </button>
                        </td>
                    </tr>
                `;
            });
            feather.replace();
        }

        function abrirModalAdmin(id) {
            const producto = inventario.find(p => p.id === id);
            document.getElementById('edit-id').value = producto.id;
            document.getElementById('edit-nombre').value = producto.nombre;
            document.getElementById('edit-precio').value = producto.precio;
            document.getElementById('edit-imagen').value = producto.img;
            
            document.getElementById('modal-admin-editar').classList.remove('hidden');
            document.getElementById('modal-admin-editar').classList.add('flex');
        }

        function cerrarModalAdmin() {
            document.getElementById('modal-admin-editar').classList.add('hidden');
            document.getElementById('modal-admin-editar').classList.remove('flex');
        }

        function guardarEdicionProducto() {
            const id = parseInt(document.getElementById('edit-id').value);
            const nuevoNombre = document.getElementById('edit-nombre').value;
            const nuevoPrecio = parseFloat(document.getElementById('edit-precio').value);
            const nuevaImg = document.getElementById('edit-imagen').value;

            // Actualizar en el arreglo
            let producto = inventario.find(p => p.id === id);
            producto.nombre = nuevoNombre;
            producto.precio = nuevoPrecio;
            producto.img = nuevaImg;

            cerrarModalAdmin();
            renderizarAdmin(); // Actualiza la tabla
            renderizarCatalogo(); // Actualiza el catálogo público
            
            mostrarMensaje('Actualizado', 'El producto ha sido modificado exitosamente.', 'check');
        }

        // 7. SISTEMA DE ALERTAS (MODALES ELEGANTES)
        function mostrarMensaje(titulo, texto, icono) {
            document.getElementById('modal-titulo').innerText = titulo;
            document.getElementById('modal-texto').innerText = texto;
            document.getElementById('modal-icono').innerHTML = `<i data-feather="${icono}" class="w-12 h-12"></i>`;
            
            const modal = document.getElementById('modal-mensaje');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            feather.replace();
        }

        function cerrarModalMensaje() {
            const modal = document.getElementById('modal-mensaje');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Inicializar la primera vista (Inicio)
        renderizarCatalogo();
    </script>
</body>
</html>
